{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskSeek",
  "version": "0.6.0",
  "identifier": "com.danel.deskseek",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DeskSeek",
        "width": 1180,
        "height": 800,
        "minWidth": 820,
        "minHeight": 560
      },
      {
        "label": "quick",
        "title": "Quick entry",
        "width": 560,
        "height": 132,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Danel Rahmani",
    "copyright": "© 2026 Danel Rahmani",
    "category": "Productivity",
    "shortDescription": "A desktop client for the DeepSeek API.",
    "longDescription": "DeskSeek is a lightweight desktop client for the DeepSeek API. Chat with a streaming assistant that keeps a memory across conversations, or point an agent at a folder and let it read, search, edit and run commands — behind approvals, a path sandbox and a safety guard.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
